# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/intervue?retryWrites=true&w=majority&appName=Intervue
MONGODB_DB_NAME=intervue_proctoring

# Application Configuration
SECRET_KEY=your-secret-key-here-change-in-production
HOST_PASSWORD=admin123
SESSION_COOKIE_SECURE=1

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5000,https://127.0.0.1:5000

# OpenAI Configuration (optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Partner Configuration (for white-label embed)
PARTNER_API_KEYS=partner1:api_key_1,partner2:api_key_2