# Supabase Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key

# Application Configuration
SECRET_KEY=your-secret-key-here-change-in-production
HOST_PASSWORD=admin123
# Set to 1 only when serving over HTTPS (production). Leave 0/empty locally.
SESSION_COOKIE_SECURE=0
# Set to 1 to run Flask with the interactive debugger (development only).
FLASK_DEBUG=0
# Optional: bind host/port (defaults 0.0.0.0 / 5000)
# HOST=0.0.0.0
# PORT=5000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5000,https://127.0.0.1:5000

# OpenAI Configuration (optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Partner Configuration (for white-label embed) — REQUIRED for /embed-view
# Format: comma-separated partner_id:api_key pairs, e.g.
# PARTNER_API_KEYS=partner1:api_key_1,partner2:api_key_2
# The API key is checked with a constant-time compare; unknown partners are
# rejected with 403.
PARTNER_API_KEYS=

# Google OAuth — enables "Continue with Google" on the login page
# 1. Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
#    (Application type: "Web application")
# 2. Add the callback URL under "Authorized redirect URIs" — the app shows the
#    exact URL to register on the login page and at /api/auth/status, e.g.:
#    http://127.0.0.1:5000/api/auth/google/callback
# 3. Paste the Client ID / Client Secret below, then restart the server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 1. Create an OAuth App at https://github.com/settings/developers
